@implements IDisposable
@inject WebAdmin.Services.UserSession Session
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🍜 Thuyết Minh Ẩm Thực</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        @if (Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="pois">
                    <span class="bi bi-map" aria-hidden="true"></span> Quản lý POI
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="translations">
                    <span class="bi bi-chat-text" aria-hidden="true"></span> Nội dung thuyết minh
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="audio">
                    <span class="bi bi-music-note" aria-hidden="true"></span> Quản lý Audio
                </NavLink>
            </div>
            @if (Session.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="languagesetting">
                        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Quản lý Ngôn ngữ
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="tours">
                    <span class="bi bi-map" aria-hidden="true"></span> Quản lý Tour
                </NavLink>
            </div>

            @if (Session.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <span class="bi bi-people" aria-hidden="true"></span> Quản lý User
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="qr">
                    <span class="bi bi-qr-code" aria-hidden="true"></span> QR
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="languages">
                    <span class="bi bi-globe" aria-hidden="true"></span> Thống kê
                </NavLink>
            </div>

            @if (Session.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="analytics">
                        <span class="bi bi-bar-chart"></span> Thống kê
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="monitoring">
                        <span class="bi bi-activity" aria-hidden="true"></span> Monitoring
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3 mt-auto mb-3">
                <button class="btn logout-btn w-100 d-flex align-items-center justify-content-between py-2 shadow-sm" @onclick="Logout">
                    <div class="text-start">
                        <small class="d-block text-white-50" style="font-size: 0.7rem;">ĐANG ĐĂNG NHẬP</small>
                        <span class="fw-bold text-white">@Session.FullName</span>
                    </div>
                    <i class="bi bi-box-arrow-right fs-5 text-warning"></i>
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-person" aria-hidden="true"></span> Đăng nhập
                </NavLink>
            </div>
        }

    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        // 🎧 Đăng ký: Khi Session báo có thay đổi, NavMenu sẽ tự StateHasChanged()
        Session.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        // Hủy đăng ký để tránh rò rỉ bộ nhớ
        Session.OnChange -= StateHasChanged;
    }

    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}

