@page "/analytics"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject UserSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Thống kê & Monitoring</h3>

<!-- Metric cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center p-3 border-primary">
            <div class="text-muted small">Du khách đang online</div>
            <div class="fs-2 fw-bold text-primary">@(summary?.ActiveUsers ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-success">
            <div class="text-muted small">Tổng du khách</div>
            <div class="fs-2 fw-bold text-success">@(summary?.Total ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-warning">
            <div class="text-muted small">Du khách hôm nay</div>
            <div class="fs-2 fw-bold text-warning">@(summary?.TodayCount ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-info">
            <div class="text-muted small">Tổng lượt nghe</div>
            <div class="fs-2 fw-bold text-info">@(summary?.TotalListens ?? 0)</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Top POI -->
    <div class="col-md-6">
        <div class="card p-3">
            <h5>Top điểm nghe nhiều nhất</h5>
            @if (topPois != null && topPois.Any())
            {
                @foreach (var poi in topPois)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>@poi.PoiName</span>
                        <span class="badge bg-primary">@poi.Count</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Chưa có dữ liệu</p>
            }
        </div>
    </div>

    <!-- Avg Duration -->
    <div class="col-md-6">
        <div class="card p-3">
            <h5>Thời gian nghe trung bình</h5>
            @if (avgDurations != null && avgDurations.Any())
            {
                <table class="table table-sm">
                    <tbody>
                        @foreach (var d in avgDurations)
                        {
                            <tr>
                                <td>@d.PoiName</td>
                                <td>@(d.AvgSeconds / 60)p @(d.AvgSeconds % 60)s</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Chưa có dữ liệu</p>
            }
        </div>
    </div>
</div>

<!-- 🔥 MAP -->
<div class="card p-3 mt-3">
    <h5>Heatmap vị trí du khách</h5>

    @if (heatmapPoints != null && heatmapPoints.Any())
    {
        <div id="map" style="height:400px;border-radius:10px;"></div>
    }
    else
    {
        <p class="text-muted">Chưa có dữ liệu vị trí</p>
    }
</div>

<div class="mt-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData">
        Làm mới dữ liệu
    </button>
</div>

@code {
    private SummaryDto? summary;
    private List<TopPoiDto>? topPois;
    private List<AvgDurationDto>? avgDurations;
    private List<HeatmapPoint>? heatmapPoints;
    private bool shouldRenderMap = false;
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var http = HttpFactory.CreateClient("WebAPI");

        var active = await http.GetFromJsonAsync<ActiveDto>("/api/Analytics/active-users");
        var sum = await http.GetFromJsonAsync<SumDto>("/api/Analytics/summary");

        summary = new SummaryDto
        {
            ActiveUsers = active?.ActiveUsers ?? 0,
            Total = sum?.Total ?? 0,
            TodayCount = sum?.TodayCount ?? 0,
            TotalListens = sum?.TotalListens ?? 0
        };

        topPois = await http.GetFromJsonAsync<List<TopPoiDto>>("/api/Analytics/top-pois");
        avgDurations = await http.GetFromJsonAsync<List<AvgDurationDto>>("/api/Analytics/avg-duration");
        heatmapPoints = await http.GetFromJsonAsync<List<HeatmapPoint>>("/api/Analytics/heatmap");
        shouldRenderMap = heatmapPoints != null && heatmapPoints.Any();
        StateHasChanged();
        
    }

    public class SummaryDto
    {
        public int ActiveUsers { get; set; }
        public int Total { get; set; }
        public int TodayCount { get; set; }
        public int TotalListens { get; set; }
    }

    public class ActiveDto { public int ActiveUsers { get; set; } }

    public class SumDto
    {
        public int Total { get; set; }
        public int TodayCount { get; set; }
        public int TotalListens { get; set; }
    }

    public class TopPoiDto
    {
        public string? PoiName { get; set; }
        public int Count { get; set; }
    }

    public class AvgDurationDto
    {
        public string? PoiName { get; set; }
        public int AvgSeconds { get; set; }
    }

    public class HeatmapPoint
    {
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
    }
  protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (shouldRenderMap && heatmapPoints != null && heatmapPoints.Any())
    {
        shouldRenderMap = false;
        await JS.InvokeVoidAsync("loadHeatmap", heatmapPoints);
    }
}
}
