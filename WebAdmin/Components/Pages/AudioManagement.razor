@page "/audio"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject UserSession Session
@inject NavigationManager Nav

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded-3">
        <div>
            <h3 class="fw-bold text-primary mb-0"><i class="bi bi-mic-fill me-2"></i>Quản lý nội dung thuyết minh</h3>
            <small class="text-muted">App mobile sẽ dùng Text-to-Speech trên thiết bị để đọc nội dung đa ngôn ngữ</small>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-2">
                    <label class="fw-bold text-secondary text-uppercase small">Chọn POI</label>
                </div>
                <div class="col-md-6">
                    <select class="form-select border-primary-subtle shadow-sm" @onchange="OnPoiChanged">
                        <option value="0">-- Chọn địa điểm để quản lý nội dung thuyết minh --</option>
                        @if (pois != null)
                        {
                            @foreach (var poi in pois)
                            {
                                <option value="@poi.Id">@poi.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (selectedPoiId > 0)
    {
        @if (!Session.IsAdmin && Session.PoiId != selectedPoiId)
        {
            <div class="alert alert-warning border-0 shadow-sm">
                <i class="bi bi-exclamation-octagon-fill me-2"></i> Bạn không có quyền quản lý nội dung cho địa điểm này.
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert @(isError ? "alert-danger" : "alert-success") border-0 shadow-sm alert-dismissible fade show">
                    <i class="bi @(isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i> @message
                    <button type="button" class="btn-close" @onclick='() => message = ""'></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-primary text-white text-uppercase small">
                            <tr>
                                <th class="ps-4 py-3">Ngôn ngữ</th>
                                <th>Nội dung văn bản</th>
                                <th>Trạng thái</th>
                                <th class="text-center pe-4">Hành động</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white">
                            @if (translations == null)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status"></div>
                                        <div class="mt-2 text-muted">Đang tải bản dịch...</div>
                                    </td>
                                </tr>
                            }
                            else if (!translations.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted small">
                                        Địa điểm này chưa có nội dung thuyết minh. Hãy qua trang Bản dịch để soạn thảo trước.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var t in translations)
                                {
                                    var isUpdated = updatedLanguages.Contains(t.Language);

                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-dark border">@GetLanguageLabel(t.Language)</span>
                                                <span class="fw-bold text-dark">@t.Language.ToUpperInvariant()</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-muted small text-truncate" style="max-width: 420px;" title="@t.Text">
                                                @t.Text
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(isUpdated ? "bg-success-subtle text-success border-success-subtle" : "bg-info-subtle text-info border-info-subtle") border px-2">
                                                <i class="bi @(isUpdated ? "bi-check-circle-fill" : "bi-phone") me-1"></i>
                                                @(isUpdated ? "Đã cập nhật" : "Dùng TTS thiết bị")
                                            </span>
                                        </td>
                                        <td class="text-center pe-4">
                                            <button class="btn btn-outline-primary btn-sm px-4 rounded-pill shadow-sm"
                                                    @onclick="() => UpdateDeviceTts(t)"
                                                    disabled="@isGenerating">
                                                @if (generatingLang == t.Language)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                    <span>Đang cập nhật...</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-phone me-1"></i>
                                                    <span>Cập nhật nội dung</span>
                                                }
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 mt-5">
            <i class="bi bi-soundwave display-1 text-light"></i>
            <h4 class="text-muted mt-3">Vui lòng chọn POI để tiếp tục</h4>
            <p class="text-secondary small">Hệ thống sẽ liệt kê các bản dịch sẵn có để app mobile đọc bằng TTS thiết bị.</p>
        </div>
    }
</div>

<style>
    .table thead th { font-weight: 700; letter-spacing: 0.5px; border: none; }
    .table tbody tr { transition: background 0.2s; }
    .table tbody tr:hover { background-color: #f8faff; }
    .badge { font-weight: 500; font-size: 0.75rem; }
</style>

@code {
    private List<PoiDto>? pois;
    private List<TranslationDto>? translations;
    private HashSet<string> updatedLanguages = new(StringComparer.OrdinalIgnoreCase);
    private int selectedPoiId = 0;
    private string? message;
    private bool isError = false;
    private bool isGenerating = false;
    private string? generatingLang;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var allPois = await http.GetFromJsonAsync<List<PoiDto>>("/api/Poi");
            pois = Session.IsAdmin ? allPois : allPois?.Where(p => p.Id == Session.PoiId).ToList();
        }
        catch (Exception ex)
        {
            SetError($"Lỗi kết nối API: {ex.Message}");
        }
    }

    private static string GetLanguageLabel(string code) => code.ToLowerInvariant() switch
    {
        "vi" => "Tiếng Việt",
        "en" => "English",
        "zh" => "中文",
        "ja" => "日本語",
        "ko" => "한국어",
        "fr" => "Français",
        _ => "Ngôn ngữ"
    };

    private async Task OnPoiChanged(ChangeEventArgs e)
    {
        selectedPoiId = int.Parse(e.Value?.ToString() ?? "0");
        updatedLanguages.Clear();
        translations = null;
        message = null;
        isError = false;

        if (selectedPoiId > 0)
        {
            await LoadTranslations();
        }
    }

    private async Task LoadTranslations()
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            translations = await http.GetFromJsonAsync<List<TranslationDto>>($"/api/Translation/{selectedPoiId}");
        }
        catch (Exception ex)
        {
            SetError($"Lỗi tải dữ liệu: {ex.Message}");
        }
    }

    private async Task UpdateDeviceTts(TranslationDto t)
    {
        isGenerating = true;
        generatingLang = t.Language;
        message = null;
        isError = false;

        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var response = await http.PostAsJsonAsync("/api/Tts/generate", new
            {
                PoiId = selectedPoiId,
                Text = t.Text,
                Language = t.Language
            });

            var result = await response.Content.ReadFromJsonAsync<TtsResult>();

            if (response.IsSuccessStatusCode)
            {
                updatedLanguages.Add(t.Language);
                message = result?.Message ?? "Đã lưu/cập nhật nội dung thuyết minh. App mobile sẽ dùng Text-to-Speech trên thiết bị để đọc.";
                isError = false;
            }
            else
            {
                SetError(result?.Message ?? "Không thể cập nhật nội dung thuyết minh.");
            }
        }
        catch (Exception ex)
        {
            SetError($"Lỗi kết nối: {ex.Message}");
        }
        finally
        {
            isGenerating = false;
            generatingLang = null;
        }
    }

    private void SetError(string errorMessage)
    {
        message = errorMessage;
        isError = true;
    }

    public class PoiDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class TranslationDto
    {
        public int Id { get; set; }
        public int PoiId { get; set; }
        public string Language { get; set; } = "";
        public string Text { get; set; } = "";
        public bool HasAudio { get; set; }
    }

    public class TtsResult
    {
        public string? Message { get; set; }
        public string? AudioUrl { get; set; }
    }
}
