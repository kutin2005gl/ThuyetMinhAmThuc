@page "/audio"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Quản lý Audio</PageTitle>

<div class="cms-page">
    <section class="cms-hero">
        <div>
            <span class="eyebrow">Audio & TTS</span>
            <h1>Quản lý nội dung audio</h1>
            <p>Kiểm tra nội dung thuyết minh theo từng ngôn ngữ và cập nhật trạng thái để app mobile đọc bằng Text-to-Speech.</p>
        </div>
        @if (selectedPoiId > 0 && translations?.Any() == true && CanManageSelectedPoi)
        {
            <button class="btn btn-primary btn-lg" @onclick="UpdateAllDeviceTts" disabled="@isGenerating">
                <i class="bi bi-soundwave"></i>
                Cập nhật tất cả
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") border-0 shadow-sm d-flex align-items-center justify-content-between">
            <span><i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>@message</span>
            <button type="button" class="btn-close" @onclick="ClearMessage"></button>
        </div>
    }

    <section class="cms-panel">
        <div class="panel-heading toolbar-heading">
            <div>
                <h2>Chọn điểm tham quan</h2>
                <p>Audio được quản lý theo nội dung bản dịch của từng POI.</p>
            </div>
            <select class="form-select poi-select" value="@selectedPoiId" @onchange="OnPoiChanged">
                <option value="0">Chọn POI</option>
                @if (pois != null)
                {
                    @foreach (var poi in pois)
                    {
                        <option value="@poi.Id">@poi.Name</option>
                    }
                }
            </select>
        </div>
    </section>

    <section class="metric-grid compact">
        <div class="metric-card accent-blue">
            <i class="bi bi-translate"></i>
            <span>Bản dịch</span>
            <strong>@(translations?.Count ?? 0)</strong>
        </div>
        <div class="metric-card accent-green">
            <i class="bi bi-check-circle"></i>
            <span>Đã cập nhật</span>
            <strong>@ReadyCount</strong>
        </div>
        <div class="metric-card accent-orange">
            <i class="bi bi-phone"></i>
            <span>Dùng TTS thiết bị</span>
            <strong>@DeviceTtsCount</strong>
        </div>
    </section>

    <section class="cms-panel">
        <div class="panel-heading">
            <div>
                <h2>Trạng thái audio</h2>
                <p>@SelectedPoiName</p>
            </div>
        </div>

        @if (selectedPoiId == 0)
        {
            <div class="empty-state">
                <i class="bi bi-mic"></i>
                <h3>Chưa chọn POI</h3>
                <p>Chọn một điểm tham quan để xem các nội dung có thể đọc audio.</p>
            </div>
        }
        else if (!CanManageSelectedPoi)
        {
            <div class="permission-note">
                <i class="bi bi-lock"></i>
                Tài khoản này không có quyền quản lý audio của POI đã chọn.
            </div>
        }
        else if (translations == null)
        {
            <div class="empty-state">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Đang tải bản dịch...</p>
            </div>
        }
        else if (!translations.Any())
        {
            <div class="empty-state">
                <i class="bi bi-chat-square-text"></i>
                <h3>Chưa có nội dung</h3>
                <p>Hãy tạo bản dịch trước, sau đó quay lại đây để cập nhật audio/TTS.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table cms-table align-middle">
                    <thead>
                        <tr>
                            <th>Ngôn ngữ</th>
                            <th>Nội dung</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var translation in translations.OrderBy(t => t.Language))
                        {
                            var ready = IsReady(translation);
                            <tr>
                                <td>
                                    <div class="item-title">@GetLanguageLabel(translation.Language)</div>
                                    <div class="item-subtitle">@translation.Language.ToUpperInvariant()</div>
                                </td>
                                <td>
                                    <div class="text-clamp" title="@translation.Text">@translation.Text</div>
                                </td>
                                <td>
                                    <span class="status-pill @(ready ? "success" : "info")">
                                        <i class="bi @(ready ? "bi-check-circle" : "bi-phone")"></i>
                                        @(ready ? "Đã cập nhật" : "Sẵn sàng TTS")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => UpdateDeviceTts(translation)" disabled="@isGenerating">
                                        @if (generatingLanguage == translation.Language)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                            <span>Đang cập nhật</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-repeat"></i>
                                            <span>Cập nhật</span>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<PoiDto>? pois;
    private List<TranslationDto>? translations;
    private HashSet<string> updatedLanguages = new(StringComparer.OrdinalIgnoreCase);
    private int selectedPoiId;
    private string? message;
    private bool isError;
    private bool isGenerating;
    private string? generatingLanguage;

    private bool CanManageSelectedPoi => selectedPoiId > 0 && (Session.IsAdmin || Session.PoiId == selectedPoiId);

    private string SelectedPoiName =>
        selectedPoiId == 0
            ? "Chọn POI để xem trạng thái audio."
            : pois?.FirstOrDefault(p => p.Id == selectedPoiId)?.Name ?? $"POI #{selectedPoiId}";

    private int ReadyCount => translations?.Count(IsReady) ?? 0;

    private int DeviceTtsCount => Math.Max((translations?.Count ?? 0) - ReadyCount, 0);

    // Công dụng: kiểm tra đăng nhập và tải danh sách POI được phép quản lý audio.
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadPois();
    }

    // Công dụng: lấy danh sách POI từ API và lọc theo quyền tài khoản.
    private async Task LoadPois()
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var allPois = await http.GetFromJsonAsync<List<PoiDto>>("/api/Poi") ?? new();
            pois = Session.IsAdmin ? allPois : allPois.Where(p => p.Id == Session.PoiId).ToList();
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể tải danh sách POI: {ex.Message}", true);
        }
    }

    // Công dụng: đổi POI đang xem và tải lại các bản dịch/audio tương ứng.
    private async Task OnPoiChanged(ChangeEventArgs e)
    {
        selectedPoiId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        translations = null;
        updatedLanguages.Clear();
        ClearMessage();

        if (selectedPoiId > 0)
        {
            await LoadTranslations();
        }
    }

    // Công dụng: tải bản dịch của POI để quản lý audio/TTS theo từng ngôn ngữ.
    private async Task LoadTranslations()
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            translations = await http.GetFromJsonAsync<List<TranslationDto>>($"/api/Translation/{selectedPoiId}") ?? new();
        }
        catch (Exception ex)
        {
            translations = new();
            SetMessage($"Không thể tải nội dung audio: {ex.Message}", true);
        }
    }

    // Công dụng: cập nhật trạng thái TTS cho toàn bộ bản dịch của POI đang chọn.
    private async Task UpdateAllDeviceTts()
    {
        if (translations == null)
        {
            return;
        }

        foreach (var translation in translations)
        {
            await UpdateDeviceTts(translation, showSuccessMessage: false);
        }

        SetMessage("Đã cập nhật trạng thái TTS cho tất cả ngôn ngữ.", false);
    }

    // Công dụng: gửi một bản dịch sang API TTS để kiểm tra/cập nhật nội dung đọc trên mobile.
    private async Task UpdateDeviceTts(TranslationDto translation, bool showSuccessMessage = true)
    {
        isGenerating = true;
        generatingLanguage = translation.Language;
        ClearMessage();

        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var response = await http.PostAsJsonAsync("/api/Tts/generate", new
            {
                PoiId = selectedPoiId,
                Text = translation.Text,
                Language = translation.Language
            });

            var result = await response.Content.ReadFromJsonAsync<TtsResult>();

            if (response.IsSuccessStatusCode)
            {
                updatedLanguages.Add(translation.Language);

                if (showSuccessMessage)
                {
                    SetMessage(result?.Message ?? "Đã cập nhật nội dung TTS.", false);
                }
            }
            else
            {
                SetMessage(result?.Message ?? "Không thể cập nhật nội dung TTS.", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể kết nối API: {ex.Message}", true);
        }
        finally
        {
            isGenerating = false;
            generatingLanguage = null;
        }
    }

    // Công dụng: xác định một bản dịch đã có audio file hoặc vừa được cập nhật trong phiên hiện tại.
    private bool IsReady(TranslationDto translation) => translation.HasAudio || updatedLanguages.Contains(translation.Language);

    // Công dụng: trả về tên ngôn ngữ thân thiện cho mã language.
    private static string GetLanguageLabel(string code) => code.ToLowerInvariant() switch
    {
        "vi" => "Tiếng Việt",
        "en" => "English",
        "zh" => "Tiếng Trung",
        "ja" => "Tiếng Nhật",
        "ko" => "Tiếng Hàn",
        "fr" => "Tiếng Pháp",
        "de" => "Tiếng Đức",
        _ => "Ngôn ngữ"
    };

    // Công dụng: hiển thị thông báo thành công hoặc lỗi cho người dùng.
    private void SetMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

    // Công dụng: xóa thông báo hiện tại trên giao diện.
    private void ClearMessage()
    {
        message = null;
        isError = false;
    }

    public class PoiDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class TranslationDto
    {
        public int Id { get; set; }
        public int PoiId { get; set; }
        public string Language { get; set; } = "";
        public string Text { get; set; } = "";
        public bool HasAudio { get; set; }
    }

    public class TtsResult
    {
        public string? Message { get; set; }
        public string? AudioUrl { get; set; }
    }
}
