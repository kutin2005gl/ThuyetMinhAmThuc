@page "/monitoring"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory

<PageTitle>Monitoring hệ thống</PageTitle>

<div class="monitoring-page">
    <section class="monitoring-header">
        <div>
            <p class="eyebrow">WebAdmin</p>
            <h1>Monitoring hệ thống</h1>
            <p class="header-subtitle">Theo dõi thiết bị/guest session, lượt mở app, quét QR và lượt nghe thuyết minh POI.</p>
        </div>
        <button class="refresh-button" @onclick="LoadAsync" disabled="@isLoading">
            @(isLoading ? "Đang tải..." : "Làm mới")
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (summary == null || weekly == null)
    {
        <div class="loading-panel">Đang tải dữ liệu monitoring...</div>
    }
    else
    {
        <section class="metric-grid" aria-label="Tổng quan hiện tại">
            @foreach (var metric in GetMetrics())
            {
                <div class="metric-card accent-@metric.Accent">
                    <div class="metric-title">@metric.Title</div>
                    <div class="metric-value">@metric.Value.ToString("N0")</div>
                    <p class="metric-caption">@metric.Caption</p>
                </div>
            }
        </section>

        <section class="dashboard-section">
            <div class="section-title-row">
                <div>
                    <h2>Thống kê tuần này</h2>
                    <p>@weekly.WeekStart.ToString("dd/MM/yyyy") - @weekly.WeekEnd.ToString("dd/MM/yyyy")</p>
                </div>
            </div>

            <div class="chart-layout">
                <div class="chart-card">
                    <div class="chart-heading">
                        <h3>Thiết bị/người dùng theo ngày</h3>
                        <span>Cột càng cao nghĩa là càng nhiều thiết bị sử dụng app</span>
                    </div>
                    <div class="device-bars">
                        @foreach (var day in weekly.Days)
                        {
                            var height = GetBarHeight(day.UniqueDevices, MaxDevices);
                            <div class="bar-item">
                                <div class="bar-track">
                                    <div class="bar-fill" style="height:@height%"></div>
                                    <span>@day.UniqueDevices</span>
                                </div>
                                <strong>@day.Label</strong>
                            </div>
                        }
                    </div>
                </div>

                <div class="chart-card">
                    <div class="chart-heading">
                        <h3>Mở app / QR / Nghe POI</h3>
                        <span>So sánh các hành động chính trong tuần</span>
                    </div>
                    <div class="multi-bars">
                        @foreach (var day in weekly.Days)
                        {
                            <div class="multi-row">
                                <div class="multi-label">@day.Label</div>
                                <div class="multi-series">
                                    <div class="series-line">
                                        <span>Mở app</span>
                                        <div class="series-track"><div class="series-fill app-open" style="width:@GetBarHeight(day.AppOpens, MaxInteractions)%"></div></div>
                                        <strong>@day.AppOpens</strong>
                                    </div>
                                    <div class="series-line">
                                        <span>Quét QR</span>
                                        <div class="series-track"><div class="series-fill qr-scan" style="width:@GetBarHeight(day.QrScans, MaxInteractions)%"></div></div>
                                        <strong>@day.QrScans</strong>
                                    </div>
                                    <div class="series-line">
                                        <span>Nghe POI</span>
                                        <div class="series-track"><div class="series-fill poi-listen" style="width:@GetBarHeight(day.PoiListens, MaxInteractions)%"></div></div>
                                        <strong>@day.PoiListens</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="dashboard-section">
            <div class="section-title-row">
                <div>
                    <h2>Heatmap sử dụng app</h2>
                    <p>Màu càng đậm nghĩa là càng nhiều thiết bị/người dùng trong ngày đó.</p>
                </div>
            </div>

            <div class="heatmap-grid">
                @foreach (var day in weekly.Days)
                {
                    var intensity = GetHeatmapIntensity(day.UniqueDevices, MaxDevices);
                    <div class="heatmap-cell heat-@intensity">
                        <span>@day.Label</span>
                        <strong>@day.UniqueDevices</strong>
                        <small>@day.TotalEvents lượt sử dụng</small>
                    </div>
                }
            </div>
        </section>

        <section class="table-section">
            <h2>Chi tiết theo ngày</h2>
            <div class="table-responsive">
                <table class="table monitoring-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Thiết bị/người dùng</th>
                            <th>Lượt mở app</th>
                            <th>Lượt quét QR</th>
                            <th>Lượt nghe POI</th>
                            <th>Tổng lượt sử dụng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in weekly.Days)
                        {
                            <tr>
                                <td><strong>@day.Label</strong><span>@day.Date.ToString("dd/MM/yyyy")</span></td>
                                <td>@day.UniqueDevices</td>
                                <td>@day.AppOpens</td>
                                <td>@day.QrScans</td>
                                <td>@day.PoiListens</td>
                                <td>@day.TotalEvents</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private MonitoringSummary? summary;
    private MonitoringWeekly? weekly;
    private string? error;
    private bool isLoading;

    private int MaxDevices => Math.Max(weekly?.Days.Max(d => d.UniqueDevices) ?? 0, 1);
    private int MaxInteractions => Math.Max(weekly?.Days.Max(d => Math.Max(d.AppOpens, Math.Max(d.QrScans, d.PoiListens))) ?? 0, 1);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var summaryTask = http.GetFromJsonAsync<MonitoringSummary>("/api/monitoring/summary");
            var weeklyTask = http.GetFromJsonAsync<MonitoringWeekly>("/api/monitoring/weekly");

            summary = await summaryTask;
            weekly = await weeklyTask;
        }
        catch (Exception ex)
        {
            error = $"Không tải được dữ liệu monitoring: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static int GetBarHeight(int value, int max)
    {
        if (value <= 0)
        {
            return 0;
        }

        return Math.Clamp((int)Math.Round(value * 100m / Math.Max(max, 1)), 8, 100);
    }

    private static int GetHeatmapIntensity(int value, int max)
    {
        if (value <= 0)
        {
            return 0;
        }

        var ratio = value / (decimal)Math.Max(max, 1);
        return ratio switch
        {
            <= 0.25m => 1,
            <= 0.5m => 2,
            <= 0.75m => 3,
            _ => 4
        };
    }

    private IEnumerable<MetricItem> GetMetrics()
    {
        if (summary == null)
        {
            return [];
        }

        return
        [
            new("Đang sử dụng", summary.ActiveDevicesNow, "Thiết bị hoạt động 10 giây gần nhất", "blue"),
            new("Thiết bị hôm nay", summary.ActiveDevicesToday, "Guest session có hoạt động hôm nay", "green"),
            new("Tổng thiết bị", summary.TotalDevices, "Tất cả guest session đã ghi nhận", "violet"),
            new("Lượt mở app", summary.TotalAppOpens, "Tổng số lần mở ứng dụng", "orange"),
            new("Quét QR", summary.TotalQrScans, "Tổng lượt quét mã QR", "cyan"),
            new("Nghe POI", summary.TotalPoiListens, "Tổng lượt nghe/thuyết minh", "rose")
        ];
    }

    public class MonitoringSummary
    {
        public int TotalDevices { get; set; }
        public int ActiveDevicesNow { get; set; }
        public int ActiveDevicesToday { get; set; }
        public int TotalAppOpens { get; set; }
        public int TotalQrScans { get; set; }
        public int TotalPoiListens { get; set; }
        public int TotalEvents { get; set; }
        public DateTime GeneratedAtUtc { get; set; }
    }

    public class MonitoringWeekly
    {
        public DateTime WeekStart { get; set; }
        public DateTime WeekEnd { get; set; }
        public List<MonitoringWeeklyDay> Days { get; set; } = new();
    }

    public class MonitoringWeeklyDay
    {
        public DateTime Date { get; set; }
        public int DayOfWeek { get; set; }
        public string Label { get; set; } = string.Empty;
        public int UniqueDevices { get; set; }
        public int AppOpens { get; set; }
        public int QrScans { get; set; }
        public int PoiListens { get; set; }
        public int TotalEvents { get; set; }
    }

    private sealed record MetricItem(string Title, int Value, string Caption, string Accent);
}
