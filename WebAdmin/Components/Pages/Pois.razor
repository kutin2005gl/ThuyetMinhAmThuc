@page "/pois"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Quản lý POI</PageTitle>

<div class="cms-page">
    <section class="cms-hero">
        <div>
            <span class="eyebrow">FoodGuide CMS</span>
            <h1>Quản lý điểm tham quan</h1>
            <p>Thêm, sửa, xóa POI và cập nhật vị trí GPS, bán kính geofence, hình ảnh để app mobile hiển thị đúng nội dung.</p>
        </div>
        @if (Session.IsAdmin)
        {
            <button class="btn btn-primary btn-lg" @onclick="ShowAddForm">
                <i class="bi bi-plus-circle"></i>
                Thêm POI
            </button>
        }
    </section>

    <section class="metric-grid compact">
        <div class="metric-card accent-blue">
            <i class="bi bi-geo-alt"></i>
            <span>Tổng POI</span>
            <strong>@(pois?.Count ?? 0)</strong>
        </div>
        <div class="metric-card accent-green">
            <i class="bi bi-image"></i>
            <span>Có hình ảnh</span>
            <strong>@(pois?.Count(p => !string.IsNullOrWhiteSpace(p.ImageUrl)) ?? 0)</strong>
        </div>
        <div class="metric-card accent-orange">
            <i class="bi bi-broadcast-pin"></i>
            <span>Bán kính TB</span>
            <strong>@AverageRadiusText</strong>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") border-0 shadow-sm d-flex align-items-center justify-content-between">
            <span><i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>@message</span>
            <button type="button" class="btn-close" @onclick="ClearMessage"></button>
        </div>
    }

    @if (showForm)
    {
        <section class="cms-panel form-panel">
            <div class="panel-heading">
                <div>
                    <h2>@(editingId == 0 ? "Tạo POI mới" : "Cập nhật POI")</h2>
                    <p>Nhập thông tin đủ ngắn gọn để dễ demo, nhưng vẫn có tọa độ và bán kính cho GPS/geofence.</p>
                </div>
                <button class="btn btn-light" @onclick="HideForm">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="row g-3">
                <div class="col-lg-7">
                    <label class="form-label">Tên địa điểm</label>
                    <input class="form-control form-control-lg" @bind="form.Name" placeholder="Ví dụ: Phở Bà Dậu" />
                </div>
                <div class="col-lg-5">
                    <label class="form-label">Bán kính kích hoạt (m)</label>
                    <input class="form-control form-control-lg" type="number" min="1" step="1" @bind="form.RadiusMeters" />
                </div>
                <div class="col-12">
                    <label class="form-label">Mô tả ngắn</label>
                    <textarea class="form-control" rows="3" @bind="form.Description" placeholder="Mô tả nội dung thuyết minh chính của POI"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Vĩ độ</label>
                    <input class="form-control" type="number" step="0.000001" @bind="form.Latitude" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Kinh độ</label>
                    <input class="form-control" type="number" step="0.000001" @bind="form.Longitude" />
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-outline-secondary" @onclick="HideForm">Hủy</button>
                <button class="btn btn-success" @onclick="SavePoi" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Đang lưu</span>
                    }
                    else
                    {
                        <i class="bi bi-save"></i>
                        <span>Lưu POI</span>
                    }
                </button>
            </div>
        </section>
    }

    <section class="cms-panel">
        <div class="panel-heading toolbar-heading">
            <div>
                <h2>Danh sách POI</h2>
                <p>Quản lý các địa điểm đang hoạt động trong hệ thống.</p>
            </div>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input class="form-control" placeholder="Tìm theo tên hoặc mô tả" @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>

        @if (pois == null)
        {
            <div class="empty-state">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Đang tải danh sách POI...</p>
            </div>
        }
        else if (!FilteredPois.Any())
        {
            <div class="empty-state">
                <i class="bi bi-map"></i>
                <h3>Chưa có POI phù hợp</h3>
                <p>Thử đổi từ khóa tìm kiếm hoặc thêm POI mới.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table cms-table align-middle">
                    <thead>
                        <tr>
                            <th>Địa điểm</th>
                            <th>Tọa độ</th>
                            <th>Geofence</th>
                            <th>Hình ảnh</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var poi in FilteredPois)
                        {
                            <tr>
                                <td>
                                    <div class="item-title">@poi.Name</div>
                                    <div class="item-subtitle">@poi.Description</div>
                                </td>
                                <td>
                                    <div class="code-stack">
                                        <code>@poi.Latitude.ToString("0.000000")</code>
                                        <code>@poi.Longitude.ToString("0.000000")</code>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-pill info">@poi.RadiusMeters.ToString("0") m</span>
                                </td>
                                <td>
                                    <div class="poi-thumb">
                                        @if (!string.IsNullOrWhiteSpace(poi.ImageUrl))
                                        {
                                            <img src="@poi.ImageUrl" alt="@poi.Name" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image"></i>
                                        }

                                        @if (CanManagePoi(poi))
                                        {
                                            <label for="@($"file-{poi.Id}")" class="thumb-upload" title="Cập nhật ảnh">
                                                <i class="bi bi-camera"></i>
                                            </label>
                                            <InputFile id="@($"file-{poi.Id}")" OnChange="e => UploadImage(e, poi.Id)" accept="image/*" class="d-none" />
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="action-row justify-content-end">
                                        @if (CanManagePoi(poi))
                                        {
                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => EditPoi(poi)">
                                                <i class="bi bi-pencil"></i>
                                                Sửa
                                            </button>
                                        }
                                        @if (Session.IsAdmin)
                                        {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeletePoi(poi.Id)">
                                                <i class="bi bi-trash"></i>
                                                Xóa
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<PoiDto>? pois;
    private PoiDto form = new() { RadiusMeters = 30 };
    private bool showForm;
    private bool isSaving;
    private bool isError;
    private int editingId;
    private string message = "";
    private string searchTerm = "";

    private IEnumerable<PoiDto> FilteredPois =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? pois ?? Enumerable.Empty<PoiDto>()
            : (pois ?? Enumerable.Empty<PoiDto>()).Where(p =>
                p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private string AverageRadiusText
    {
        get
        {
            if (pois == null || !pois.Any())
            {
                return "0 m";
            }

            return $"{pois.Average(p => p.RadiusMeters):0} m";
        }
    }

    // Công dụng: kiểm tra phiên đăng nhập và tải danh sách POI khi mở trang.
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadPois();
    }

    // Công dụng: lấy POI từ API và lọc theo quyền của tài khoản đang đăng nhập.
    private async Task LoadPois()
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var allPois = await http.GetFromJsonAsync<List<PoiDto>>("/api/Poi") ?? new();
            pois = Session.IsAdmin ? allPois : allPois.Where(p => p.Id == Session.PoiId).ToList();
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể tải danh sách POI: {ex.Message}", true);
        }
    }

    // Công dụng: mở form tạo mới POI với giá trị mặc định dễ nhập.
    private void ShowAddForm()
    {
        form = new PoiDto { RadiusMeters = 30 };
        editingId = 0;
        showForm = true;
        ClearMessage();
    }

    // Công dụng: đưa dữ liệu POI đang chọn vào form để chỉnh sửa.
    private void EditPoi(PoiDto poi)
    {
        form = new PoiDto
        {
            Id = poi.Id,
            Name = poi.Name,
            Description = poi.Description,
            Latitude = poi.Latitude,
            Longitude = poi.Longitude,
            RadiusMeters = poi.RadiusMeters,
            ImageUrl = poi.ImageUrl
        };
        editingId = poi.Id;
        showForm = true;
        ClearMessage();
    }

    // Công dụng: đóng form và xóa trạng thái chỉnh sửa hiện tại.
    private void HideForm()
    {
        showForm = false;
        editingId = 0;
        form = new PoiDto { RadiusMeters = 30 };
    }

    // Công dụng: tạo mới hoặc cập nhật POI qua API.
    private async Task SavePoi()
    {
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            SetMessage("Vui lòng nhập tên địa điểm.", true);
            return;
        }

        if (form.RadiusMeters <= 0)
        {
            SetMessage("Bán kính kích hoạt phải lớn hơn 0.", true);
            return;
        }

        isSaving = true;

        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var isCreate = editingId == 0;
            var response = editingId == 0
                ? await http.PostAsJsonAsync("/api/Poi", form)
                : await http.PutAsJsonAsync($"/api/Poi/{editingId}", form);

            if (response.IsSuccessStatusCode)
            {
                await LoadPois();
                HideForm();
                SetMessage(isCreate ? "Đã thêm POI mới." : "Đã cập nhật POI.", false);
            }
            else
            {
                SetMessage($"Không thể lưu POI: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể kết nối API: {ex.Message}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    // Công dụng: xóa POI khỏi hệ thống và tải lại danh sách.
    private async Task DeletePoi(int id)
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var response = await http.DeleteAsync($"/api/Poi/{id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadPois();
                SetMessage("Đã xóa POI.", false);
            }
            else
            {
                SetMessage($"Không thể xóa POI: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể kết nối API: {ex.Message}", true);
        }
    }

    // Công dụng: tải ảnh POI lên API và cập nhật lại ảnh hiển thị trong bảng.
    private async Task UploadImage(InputFileChangeEventArgs e, int poiId)
    {
        try
        {
            var file = e.File;
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(file.OpenReadStream(5 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var http = HttpFactory.CreateClient("WebAPI");
            var response = await http.PostAsync($"/api/Poi/{poiId}/upload-image", content);

            if (response.IsSuccessStatusCode)
            {
                await LoadPois();
                SetMessage("Đã cập nhật ảnh POI.", false);
            }
            else
            {
                SetMessage($"Không thể tải ảnh: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể tải ảnh: {ex.Message}", true);
        }
    }

    // Công dụng: xác định tài khoản hiện tại có quyền sửa POI này hay không.
    private bool CanManagePoi(PoiDto poi) => Session.IsAdmin || Session.PoiId == poi.Id;

    // Công dụng: hiển thị thông báo thành công hoặc lỗi cho người dùng.
    private void SetMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

    // Công dụng: xóa thông báo hiện tại trên giao diện.
    private void ClearMessage()
    {
        message = "";
        isError = false;
    }

    public class PoiDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double RadiusMeters { get; set; }
        public string? ImageUrl { get; set; }
    }
}
