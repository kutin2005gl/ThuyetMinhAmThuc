@page "/qr"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject UserSession Session
@inject NavigationManager Nav

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded-3">
        <div>
            <h3 class="fw-bold text-primary mb-0">
                <i class="bi bi-qr-code-scan me-2"></i>Quản lý QR Code & Tọa độ
            </h3>
            <small class="text-muted">
                @(Session.IsAdmin ? "Hệ thống quản lý toàn bộ mã QR địa điểm" : $"Mã QR định danh cho quầy của bạn")
            </small>
        </div>
    </div>

    @if (pois == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tải dữ liệu...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="ps-4 py-3">TÊN QUẦY</th>
                            <th>VỊ TRÍ (LAT/LNG)</th>
                            <th>BÁN KÍNH</th>
                            <th class="text-center pe-4">MÃ QR ĐỊNH DANH</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        @foreach (var poi in pois)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark fs-5">@poi.Name</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <code class="text-danger small">LAT: @poi.Latitude</code>
                                        <code class="text-primary small">LNG: @poi.Longitude</code>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@poi.RadiusMeters m</span>
                                </td>
                                <td class="text-center pe-4 py-3">
                                    <div class="d-inline-block p-2 border rounded bg-white shadow-sm mb-2">
                                        <img src="http://localhost:5000/api/Qr/@poi.Id" 
                                             alt="QR @poi.Name" 
                                             style="width:100px; height:100px; object-fit:contain" />
                                    </div>
                                    <br />
                                    <a href="http://localhost:5000/api/Qr/@poi.Id" 
                                       download="qr_@(poi.Name.Replace(" ", "_")).png" 
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">
                                        <i class="bi bi-download me-1"></i> Tải mã QR
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<PoiDto>? pois;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadPois();
    }

    private async Task LoadPois()
    {
        try 
        {
            var http = HttpFactory.CreateClient("WebAPI");
            // Lấy toàn bộ danh sách từ API trước
            var allPois = await http.GetFromJsonAsync<List<PoiDto>>("/api/Poi");

            // Thực hiện phân quyền giống trang POI:
            // Nếu là Admin thì lấy hết, nếu là Staff thì chỉ lọc lấy POI có Id trùng với Session.PoiId
            pois = Session.IsAdmin 
                   ? allPois 
                   : allPois?.Where(p => p.Id == Session.PoiId).ToList();
        } 
        catch (Exception ex) 
        {
            Console.WriteLine($"Lỗi tải dữ liệu: {ex.Message}");
        }
    }

    public class PoiDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double RadiusMeters { get; set; }
    }
}