@page "/tours"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Quản lý Tour</PageTitle>

<div class="cms-page">
    <section class="cms-hero">
        <div>
            <span class="eyebrow">Lộ trình tham quan</span>
            <h1>Quản lý Tour</h1>
            <p>Tạo, sửa, xóa tour và sắp xếp thứ tự POI để demo luồng tham quan hoàn chỉnh trong app FoodGuide.</p>
        </div>
        @if (Session.IsAdmin)
        {
            <button class="btn btn-primary btn-lg" @onclick="BeginCreate">
                <i class="bi bi-plus-circle"></i>
                Tạo tour
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") border-0 shadow-sm d-flex align-items-center justify-content-between">
            <span><i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>@message</span>
            <button type="button" class="btn-close" @onclick="ClearMessage"></button>
        </div>
    }

    <section class="metric-grid compact">
        <div class="metric-card accent-blue">
            <i class="bi bi-map"></i>
            <span>Tổng tour</span>
            <strong>@(tours?.Count ?? 0)</strong>
        </div>
        <div class="metric-card accent-green">
            <i class="bi bi-geo"></i>
            <span>POI khả dụng</span>
            <strong>@(allPois?.Count ?? 0)</strong>
        </div>
        <div class="metric-card accent-orange">
            <i class="bi bi-signpost-2"></i>
            <span>Tour dài nhất</span>
            <strong>@LongestTourText</strong>
        </div>
    </section>

    <div class="cms-split">
        @if (Session.IsAdmin)
        {
            <section class="cms-panel form-panel sticky-panel">
                <div class="panel-heading">
                    <div>
                        <h2>@(editingTourId == 0 ? "Tạo tour" : "Sửa tour")</h2>
                        <p>Chọn POI theo đúng thứ tự khách sẽ tham quan.</p>
                    </div>
                    @if (editingTourId != 0)
                    {
                        <button class="btn btn-light" @onclick="BeginCreate">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Tên tour</label>
                    <input class="form-control form-control-lg" @bind="form.Name" placeholder="Ví dụ: Tour ẩm thực trung tâm" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea class="form-control" rows="3" @bind="form.Description" placeholder="Mô tả ngắn về trải nghiệm tour"></textarea>
                </div>

                <div class="poi-check-list">
                    <div class="list-title">Chọn POI</div>
                    @if (allPois == null)
                    {
                        <div class="empty-inline">Đang tải POI...</div>
                    }
                    else if (!allPois.Any())
                    {
                        <div class="empty-inline">Chưa có POI để tạo tour.</div>
                    }
                    else
                    {
                        @foreach (var poi in allPois)
                        {
                            <label class="poi-check-item" for="@($"tour-poi-{poi.Id}")">
                                <input id="@($"tour-poi-{poi.Id}")"
                                       type="checkbox"
                                       checked="@selectedPoiIds.Contains(poi.Id)"
                                       @onchange="e => TogglePoi(poi.Id, e)" />
                                <span>@poi.Name</span>
                            </label>
                        }
                    }
                </div>

                @if (selectedPoiIds.Any())
                {
                    <div class="route-builder">
                        <div class="list-title">Thứ tự tham quan</div>
                        @foreach (var poiId in selectedPoiIds)
                        {
                            var index = selectedPoiIds.IndexOf(poiId);
                            <div class="route-row">
                                <span class="route-order">@((index + 1).ToString("00"))</span>
                                <strong>@GetPoiName(poiId)</strong>
                                <div class="route-actions">
                                    <button class="btn btn-light btn-sm" @onclick="() => MovePoi(poiId, -1)" disabled="@(index == 0)" title="Đưa lên">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                    <button class="btn btn-light btn-sm" @onclick="() => MovePoi(poiId, 1)" disabled="@(index == selectedPoiIds.Count - 1)" title="Đưa xuống">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="form-actions">
                    <button class="btn btn-outline-secondary" @onclick="ResetForm">Làm mới</button>
                    <button class="btn btn-success" @onclick="SaveTour" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Đang lưu</span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                            <span>@(editingTourId == 0 ? "Tạo tour" : "Lưu tour")</span>
                        }
                    </button>
                </div>
            </section>
        }

        <section class="cms-panel">
            <div class="panel-heading toolbar-heading">
                <div>
                    <h2>Danh sách tour</h2>
                    <p>Các tour đang hoạt động và lộ trình POI tương ứng.</p>
                </div>
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input class="form-control" placeholder="Tìm tour" @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>

            @if (tours == null)
            {
                <div class="empty-state">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p>Đang tải danh sách tour...</p>
                </div>
            }
            else if (!FilteredTours.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-signpost-2"></i>
                    <h3>Chưa có tour phù hợp</h3>
                    <p>Tạo tour mới hoặc đổi từ khóa tìm kiếm.</p>
                </div>
            }
            else
            {
                <div class="tour-list">
                    @foreach (var tour in FilteredTours)
                    {
                        var orderedPois = tour.Pois.OrderBy(p => p.Order).ToList();
                        <article class="tour-card">
                            <div class="tour-card-header">
                                <div>
                                    <h3>@tour.Name</h3>
                                    <p>@tour.Description</p>
                                </div>
                                @if (Session.IsAdmin)
                                {
                                    <div class="action-row">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => EditTour(tour)">
                                            <i class="bi bi-pencil"></i>
                                            Sửa
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTour(tour.Id)">
                                            <i class="bi bi-trash"></i>
                                            Xóa
                                        </button>
                                    </div>
                                }
                            </div>

                            @if (orderedPois.Any())
                            {
                                <div class="route-preview">
                                    @foreach (var poi in orderedPois)
                                    {
                                        <div class="route-chip">
                                            <span>@poi.Order</span>
                                            @poi.Name
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-inline">Tour này chưa có POI.</div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private List<TourDto>? tours;
    private List<PoiDto>? allPois;
    private List<int> selectedPoiIds = new();
    private TourForm form = new();
    private int editingTourId;
    private bool isSaving;
    private bool isError;
    private string? message;
    private string searchTerm = "";

    private IEnumerable<TourDto> FilteredTours =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? tours ?? Enumerable.Empty<TourDto>()
            : (tours ?? Enumerable.Empty<TourDto>()).Where(t =>
                t.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                t.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private string LongestTourText
    {
        get
        {
            var max = tours?.Select(t => t.Pois.Count).DefaultIfEmpty(0).Max() ?? 0;
            return $"{max} POI";
        }
    }

    // Công dụng: kiểm tra đăng nhập và tải dữ liệu tour khi mở trang.
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    // Công dụng: tải danh sách POI và tour từ API.
    private async Task LoadData()
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            allPois = await http.GetFromJsonAsync<List<PoiDto>>("/api/Poi") ?? new();
            await LoadTours();
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể tải dữ liệu tour: {ex.Message}", true);
        }
    }

    // Công dụng: tải lại danh sách tour đang hoạt động.
    private async Task LoadTours()
    {
        var http = HttpFactory.CreateClient("WebAPI");
        tours = await http.GetFromJsonAsync<List<TourDto>>("/api/Tour") ?? new();
    }

    // Công dụng: chuyển form về chế độ tạo tour mới.
    private void BeginCreate()
    {
        editingTourId = 0;
        ResetForm();
        ClearMessage();
    }

    // Công dụng: đưa tour đang chọn vào form để chỉnh sửa.
    private void EditTour(TourDto tour)
    {
        editingTourId = tour.Id;
        form = new TourForm
        {
            Name = tour.Name,
            Description = tour.Description
        };
        selectedPoiIds = tour.Pois.OrderBy(p => p.Order).Select(p => p.PoiId).ToList();
        ClearMessage();
    }

    // Công dụng: thêm hoặc bỏ POI trong lộ trình tour.
    private void TogglePoi(int poiId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool value && value;

        if (isChecked)
        {
            if (!selectedPoiIds.Contains(poiId))
            {
                selectedPoiIds.Add(poiId);
            }
        }
        else
        {
            selectedPoiIds.Remove(poiId);
        }
    }

    // Công dụng: đổi thứ tự một POI trong lộ trình tour.
    private void MovePoi(int poiId, int direction)
    {
        var currentIndex = selectedPoiIds.IndexOf(poiId);
        var nextIndex = currentIndex + direction;

        if (currentIndex < 0 || nextIndex < 0 || nextIndex >= selectedPoiIds.Count)
        {
            return;
        }

        selectedPoiIds.RemoveAt(currentIndex);
        selectedPoiIds.Insert(nextIndex, poiId);
    }

    // Công dụng: tạo mới hoặc cập nhật tour qua API.
    private async Task SaveTour()
    {
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            SetMessage("Vui lòng nhập tên tour.", true);
            return;
        }

        if (!selectedPoiIds.Any())
        {
            SetMessage("Vui lòng chọn ít nhất một POI cho tour.", true);
            return;
        }

        isSaving = true;

        try
        {
            var payload = new
            {
                form.Name,
                form.Description,
                PoiIds = selectedPoiIds
            };

            var http = HttpFactory.CreateClient("WebAPI");
            var isCreate = editingTourId == 0;
            var response = isCreate
                ? await http.PostAsJsonAsync("/api/Tour", payload)
                : await http.PutAsJsonAsync($"/api/Tour/{editingTourId}", payload);

            if (response.IsSuccessStatusCode)
            {
                await LoadTours();
                BeginCreate();
                SetMessage(isCreate ? "Đã tạo tour mới." : "Đã cập nhật tour.", false);
            }
            else
            {
                SetMessage($"Không thể lưu tour: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể kết nối API: {ex.Message}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    // Công dụng: xóa mềm tour khỏi danh sách đang hoạt động.
    private async Task DeleteTour(int id)
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var response = await http.DeleteAsync($"/api/Tour/{id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadTours();
                if (editingTourId == id)
                {
                    BeginCreate();
                }

                SetMessage("Đã xóa tour.", false);
            }
            else
            {
                SetMessage($"Không thể xóa tour: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể kết nối API: {ex.Message}", true);
        }
    }

    // Công dụng: xóa dữ liệu đang nhập trong form tour.
    private void ResetForm()
    {
        form = new TourForm();
        selectedPoiIds = new();
    }

    // Công dụng: lấy tên POI từ id để hiển thị trong trình sắp xếp lộ trình.
    private string GetPoiName(int poiId) => allPois?.FirstOrDefault(p => p.Id == poiId)?.Name ?? $"POI #{poiId}";

    // Công dụng: hiển thị thông báo thành công hoặc lỗi.
    private void SetMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

    // Công dụng: xóa thông báo hiện tại.
    private void ClearMessage()
    {
        message = null;
        isError = false;
    }

    public class TourDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public List<TourPoiDto> Pois { get; set; } = new();
    }

    public class TourPoiDto
    {
        public int Order { get; set; }
        public int PoiId { get; set; }
        public string Name { get; set; } = "";
    }

    public class PoiDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class TourForm
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
