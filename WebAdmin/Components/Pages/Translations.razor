@page "/translations"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Quản lý bản dịch</PageTitle>

<div class="cms-page">
    <section class="cms-hero">
        <div>
            <span class="eyebrow">Nội dung đa ngôn ngữ</span>
            <h1>Quản lý bản dịch</h1>
            <p>Soạn nội dung thuyết minh cho từng POI, lưu bản nguồn và tự động dịch sang các ngôn ngữ đang được cấu hình.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-info") border-0 shadow-sm d-flex align-items-center justify-content-between">
            <span><i class="bi @(isError ? "bi-exclamation-triangle" : "bi-info-circle")"></i>@message</span>
            <button type="button" class="btn-close" @onclick="ClearMessage"></button>
        </div>
    }

    <div class="cms-split">
        <section class="cms-panel form-panel">
            <div class="panel-heading">
                <div>
                    <h2>Soạn nội dung</h2>
                    <p>Chọn POI, chọn ngôn ngữ nguồn rồi lưu để hệ thống cập nhật bản dịch.</p>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Điểm tham quan</label>
                <select class="form-select form-select-lg" value="@selectedPoiId" @onchange="OnPoiChanged">
                    <option value="0">Chọn POI cần quản lý</option>
                    @if (pois != null)
                    {
                        @foreach (var poi in pois)
                        {
                            <option value="@poi.Id">@poi.Name</option>
                        }
                    }
                </select>
            </div>

            @if (selectedPoiId > 0)
            {
                @if (CanEditSelectedPoi)
                {
                    <div class="mb-3">
                        <label class="form-label">Ngôn ngữ nguồn</label>
                        <select class="form-select" @bind="form.Language">
                            @foreach (var lang in AvailableLanguageOptions)
                            {
                                <option value="@lang.Code">@lang.Name (@lang.Code.ToUpperInvariant())</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung thuyết minh</label>
                        <textarea class="form-control" rows="10" @bind="form.Text" placeholder="Nhập nội dung giới thiệu món ăn, câu chuyện, nguồn gốc hoặc hướng dẫn tham quan..."></textarea>
                    </div>

                    <div class="form-actions">
                        <button class="btn btn-outline-secondary" @onclick="ResetForm">Làm mới</button>
                        <button class="btn btn-success" @onclick="SaveTranslation" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Đang lưu</span>
                            }
                            else
                            {
                                <i class="bi bi-translate"></i>
                                <span>Lưu và dịch</span>
                            }
                        </button>
                    </div>
                }
                else
                {
                    <div class="permission-note">
                        <i class="bi bi-lock"></i>
                        Tài khoản này không có quyền chỉnh sửa nội dung của POI đã chọn.
                    </div>
                }
            }
            else
            {
                <div class="permission-note muted">
                    <i class="bi bi-arrow-left-right"></i>
                    Chọn một POI để bắt đầu soạn nội dung.
                </div>
            }
        </section>

        <section class="cms-panel">
            <div class="panel-heading toolbar-heading">
                <div>
                    <h2>Bản dịch hiện có</h2>
                    <p>@SelectedPoiName</p>
                </div>
                <span class="status-pill info">@(translations?.Count ?? 0) bản dịch</span>
            </div>

            @if (selectedPoiId == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-chat-left-text"></i>
                    <h3>Chưa chọn POI</h3>
                    <p>Danh sách bản dịch sẽ hiển thị sau khi chọn điểm tham quan.</p>
                </div>
            }
            else if (translations == null)
            {
                <div class="empty-state">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p>Đang tải bản dịch...</p>
                </div>
            }
            else if (!translations.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-translate"></i>
                    <h3>Chưa có bản dịch</h3>
                    <p>Hãy nhập nội dung nguồn ở khung bên trái để tạo bản dịch đầu tiên.</p>
                </div>
            }
            else
            {
                <div class="translation-list">
                    @foreach (var translation in translations.OrderBy(t => t.Language))
                    {
                        <article class="translation-card">
                            <div class="translation-card-header">
                                <div>
                                    <span class="language-chip">@GetLanguageName(translation.Language)</span>
                                    <strong>@translation.Language.ToUpperInvariant()</strong>
                                </div>
                                @if (CanEditSelectedPoi)
                                {
                                    <div class="action-row">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => EditTranslation(translation)">
                                            <i class="bi bi-pencil"></i>
                                            Sửa
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTranslation(translation.Id)">
                                            <i class="bi bi-trash"></i>
                                            Xóa
                                        </button>
                                    </div>
                                }
                            </div>
                            <p>@translation.Text</p>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private List<PoiDto>? pois;
    private List<TranslationDto>? translations;
    private List<SupportedLanguageDto> availableLanguages = new();
    private TranslationForm form = new();
    private int selectedPoiId;
    private string? message;
    private bool isError;
    private bool isSaving;

    private IEnumerable<SupportedLanguageDto> AvailableLanguageOptions =>
        availableLanguages.Any()
            ? availableLanguages
            : new[] { new SupportedLanguageDto { Code = "vi", Name = "Tiếng Việt" } };

    private bool CanEditSelectedPoi => selectedPoiId > 0 && (Session.IsAdmin || Session.PoiId == selectedPoiId);

    private string SelectedPoiName =>
        selectedPoiId == 0
            ? "Chọn POI để xem nội dung thuyết minh."
            : pois?.FirstOrDefault(p => p.Id == selectedPoiId)?.Name ?? $"POI #{selectedPoiId}";

    // Công dụng: kiểm tra phiên đăng nhập và tải POI, ngôn ngữ cho trang bản dịch.
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadBaseData();
    }

    // Công dụng: tải danh sách POI và ngôn ngữ đang hỗ trợ từ API.
    private async Task LoadBaseData()
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var allPois = await http.GetFromJsonAsync<List<PoiDto>>("/api/Poi") ?? new();
            pois = Session.IsAdmin ? allPois : allPois.Where(p => p.Id == Session.PoiId).ToList();
            availableLanguages = await http.GetFromJsonAsync<List<SupportedLanguageDto>>("/api/Language") ?? new();
            form.Language = AvailableLanguageOptions.First().Code;
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể tải dữ liệu nền: {ex.Message}", true);
        }
    }

    // Công dụng: xử lý khi người dùng chọn POI khác và tải bản dịch tương ứng.
    private async Task OnPoiChanged(ChangeEventArgs e)
    {
        selectedPoiId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        ResetForm();
        ClearMessage();

        if (selectedPoiId > 0)
        {
            await LoadTranslations();
        }
        else
        {
            translations = null;
        }
    }

    // Công dụng: tải toàn bộ bản dịch của POI đang chọn.
    private async Task LoadTranslations()
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            translations = await http.GetFromJsonAsync<List<TranslationDto>>($"/api/Translation/{selectedPoiId}") ?? new();
        }
        catch (Exception ex)
        {
            translations = new();
            SetMessage($"Không thể tải bản dịch: {ex.Message}", true);
        }
    }

    // Công dụng: lưu bản dịch nguồn và yêu cầu API tự dịch sang các ngôn ngữ còn lại.
    private async Task SaveTranslation()
    {
        if (selectedPoiId <= 0)
        {
            SetMessage("Vui lòng chọn POI trước khi lưu.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(form.Text))
        {
            SetMessage("Vui lòng nhập nội dung thuyết minh.", true);
            return;
        }

        isSaving = true;
        SetMessage("Đang lưu nội dung và cập nhật bản dịch tự động...", false);

        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var response = await http.PostAsJsonAsync("/api/Translation", new
            {
                PoiId = selectedPoiId,
                form.Language,
                form.Text
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveResult>();
                SetMessage(result?.Message ?? "Đã lưu bản dịch.", false);
                ResetForm();
                await LoadTranslations();
            }
            else
            {
                SetMessage($"Không thể lưu bản dịch: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể kết nối API: {ex.Message}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    // Công dụng: đưa bản dịch đang chọn vào form để chỉnh sửa lại nội dung.
    private void EditTranslation(TranslationDto translation)
    {
        form = new TranslationForm
        {
            Language = translation.Language,
            Text = translation.Text
        };
        ClearMessage();
    }

    // Công dụng: xóa một bản dịch khỏi POI đang chọn.
    private async Task DeleteTranslation(int id)
    {
        try
        {
            var http = HttpFactory.CreateClient("WebAPI");
            var response = await http.DeleteAsync($"/api/Translation/{id}");

            if (response.IsSuccessStatusCode)
            {
                SetMessage("Đã xóa bản dịch.", false);
                await LoadTranslations();
            }
            else
            {
                SetMessage($"Không thể xóa bản dịch: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"Không thể kết nối API: {ex.Message}", true);
        }
    }

    // Công dụng: đặt lại form soạn thảo về trạng thái nhập mới.
    private void ResetForm()
    {
        form = new TranslationForm { Language = AvailableLanguageOptions.First().Code };
    }

    // Công dụng: trả về tên hiển thị thân thiện cho mã ngôn ngữ.
    private string GetLanguageName(string code)
        => availableLanguages.FirstOrDefault(l => l.Code.Equals(code, StringComparison.OrdinalIgnoreCase))?.Name
           ?? code.ToUpperInvariant();

    // Công dụng: hiển thị thông báo lỗi hoặc thông tin trên giao diện.
    private void SetMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

    // Công dụng: xóa thông báo đang hiển thị.
    private void ClearMessage()
    {
        message = null;
        isError = false;
    }

    public class PoiDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class TranslationDto
    {
        public int Id { get; set; }
        public int PoiId { get; set; }
        public string Language { get; set; } = "";
        public string Text { get; set; } = "";
    }

    public class TranslationForm
    {
        public string Language { get; set; } = "vi";
        public string Text { get; set; } = "";
    }

    public class SaveResult
    {
        public string? Message { get; set; }
    }

    public class SupportedLanguageDto
    {
        public int Id { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }
}
