<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodGuideApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodGuideApp">

    <TabBar>
        <ShellContent
            x:Name="homeTab"
            Route="Home"
            Title="Trang chủ"
            Icon="home_tab.svg"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            x:Name="poiTab"
            Route="POIs"
            Title="POI"
            Icon="poi_tab.svg"
            ContentTemplate="{DataTemplate local:PoiListPage}" />

        <ShellContent
            x:Name="tourTab"
            Route="Tours"
            Title="Tour"
            Icon="tour_tab.svg"
            ContentTemplate="{DataTemplate local:TourPage}" />

        <ShellContent
            x:Name="settingsTab"
            Route="Settings"
            Title="Cài đặt"
            Icon="settings_tab.svg"
            ContentTemplate="{DataTemplate local:SettingsPage}" />
    </TabBar>
</Shell>
