<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodGuideApp.MainPage"
             Title="Trang chủ"
             BackgroundColor="#F4F7F6">

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="18">

            <Border BackgroundColor="#0F766E"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    Padding="22">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,12" Radius="22" Opacity="0.16" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="appTitleLabel"
                           Text="HỆ THỐNG THUYẾT MINH ẨM THỰC"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#CCFBF1"
                           LineBreakMode="WordWrap" />

                    <Label x:Name="subTitleLabel"
                           Text="PoC GPS Tracking"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="WordWrap" />

                    <Label Text="Theo dõi vị trí, nhận diện POI gần nhất và phát thuyết minh đúng ngữ cảnh."
                           FontSize="14"
                           TextColor="#E0F2F1"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#64748B" Offset="0,8" Radius="18" Opacity="0.10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Trạng thái GPS"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#64748B" />

                            <Label x:Name="locationLabel"
                                   Text="Chưa có vị trí"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#ECFDF5"
                                Stroke="#A7F3D0"
                                StrokeShape="RoundRectangle 18"
                                Padding="10,6"
                                VerticalOptions="Start">
                            <Label Text="LIVE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#047857" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button x:Name="startTrackingButton"
                                Text="Bắt đầu theo dõi"
                                Clicked="OnStartTrackingClicked"
                                BackgroundColor="#0F766E"
                                TextColor="White"
                                CornerRadius="16"
                                FontAttributes="Bold"
                                HeightRequest="50" />

                        <Button x:Name="stopTrackingButton"
                                Grid.Column="1"
                                Text="Dừng theo dõi"
                                Clicked="OnStopTrackingClicked"
                                BackgroundColor="#FEE2E2"
                                TextColor="#B91C1C"
                                CornerRadius="16"
                                FontAttributes="Bold"
                                HeightRequest="50" />
                    </Grid>

                    <Button x:Name="scanQrButton"
                            Text="Quét QR"
                            Clicked="OnScanQrClicked"
                            BackgroundColor="#FFFBEB"
                            TextColor="#92400E"
                            BorderColor="#FDE68A"
                            BorderWidth="1"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#64748B" Offset="0,8" Radius="18" Opacity="0.10" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Bản đồ tham quan"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label x:Name="resultLabel"
                                   Text="Chưa tải POI"
                                   FontSize="13"
                                   TextColor="#64748B"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#EEF2FF"
                                Stroke="#C7D2FE"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,6"
                                VerticalOptions="Start">
                            <Label Text="POI"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#3730A3" />
                        </Border>
                    </Grid>

                    <WebView x:Name="mapWebView"
                             Grid.Row="1"
                             Navigated="OnMapWebViewNavigated"
                             HeightRequest="360" />
                </Grid>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#64748B" Offset="0,8" Radius="18" Opacity="0.10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <BoxView WidthRequest="4"
                                 BackgroundColor="#F59E0B"
                                 CornerRadius="2" />

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="POI gần nhất"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label x:Name="geofenceLabel"
                                   Text="Chưa vào vùng geofence"
                                   FontSize="15"
                                   TextColor="#DC2626"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button x:Name="viewNearestPoiButton"
                            Text="Xem chi tiết POI gần nhất"
                            Clicked="OnViewNearestPoiClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="50" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
