<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodGuideApp.PoiListPage"
             Title="POI"
             BackgroundColor="#F4F7F6">

    <Grid RowDefinitions="Auto,*" Padding="20,18,20,0" RowSpacing="16">

        <VerticalStackLayout Spacing="6">
            <Label x:Name="pageTitleLabel"
                   Text="Danh sách địa điểm"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#0F172A" />

            <Label Text="Chọn một điểm tham quan để xem mô tả, ảnh và nghe thuyết minh."
                   FontSize="14"
                   TextColor="#64748B"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <CollectionView x:Name="poiCollectionView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnPoiSelected"
                        ItemsLayout="VerticalList">

            <CollectionView.EmptyView>
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 20"
                        Padding="22"
                        Margin="0,20">
                    <Label Text="Chưa có dữ liệu POI"
                           FontSize="16"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="White"
                            Padding="0"
                            Margin="0,0,0,14">
                        <Border.Shadow>
                            <Shadow Brush="#64748B" Offset="0,8" Radius="18" Opacity="0.09" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="112,*" ColumnSpacing="14" Padding="12">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#E0F2F1"
                                    HeightRequest="104"
                                    WidthRequest="112"
                                    VerticalOptions="Start">
                                <Grid>
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasImage}" />

                                    <VerticalStackLayout IsVisible="{Binding HasNoImage}"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Spacing="4">
                                        <Label Text="POI"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#0F766E"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="Ảnh"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 VerticalOptions="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <Border Grid.Column="1"
                                            BackgroundColor="#ECFDF5"
                                            Stroke="#A7F3D0"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="8,4"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding DisplayDistance}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#047857" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding DisplayDescription}"
                                       FontSize="14"
                                       TextColor="#64748B"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <Label Text="Chạm để xem chi tiết"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
