<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodGuideApp.TourDetailPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label x:Name="tourNameLabel"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="Black" />

            <Label x:Name="tourDescriptionLabel"
                   FontSize="16"
                   TextColor="Gray" />

            <Label x:Name="poiSectionTitleLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black" />

            <CollectionView x:Name="poiCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnPoiSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#E0E0E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12"
                                Margin="0,0,0,10">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Order}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="Orange" />

                                <Label Text="{Binding DisplayName}"
                                       FontSize="16"
                                       TextColor="Black"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>