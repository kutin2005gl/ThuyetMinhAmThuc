<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodGuideApp.PoiListPage"
             Title="POI"
             BackgroundColor="#F6F7FB">

    <Grid RowDefinitions="Auto,*" Padding="18,16,18,0" RowSpacing="16">

        <Border BackgroundColor="#0F766E"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 26"
                Padding="18">
            <Border.Shadow>
                <Shadow Brush="#0F766E" Offset="0,10" Radius="22" Opacity="0.16" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                <Label x:Name="pageTitleLabel"
                       Text="Danh sách địa điểm"
                       FontSize="27"
                       FontAttributes="Bold"
                       TextColor="White"
                       LineBreakMode="WordWrap" />

                <Border Grid.Column="1"
                        BackgroundColor="#ECFDF5"
                        Stroke="#A7F3D0"
                        StrokeShape="RoundRectangle 14"
                        Padding="10,5"
                        VerticalOptions="Start">
                    <Label Text="POI"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#047857" />
                </Border>

                <Label Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Text="Chọn điểm tham quan để xem ảnh, mô tả, khoảng cách và nội dung thuyết minh."
                       FontSize="14"
                       TextColor="#CCFBF1"
                       LineBreakMode="WordWrap" />
            </Grid>
        </Border>

        <CollectionView x:Name="poiCollectionView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnPoiSelected"
                        ItemsLayout="VerticalList">

            <CollectionView.EmptyView>
                <Border BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 22"
                        Padding="24"
                        Margin="0,16">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="POI"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F766E"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Chưa có dữ liệu POI"
                               FontSize="15"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="White"
                            Padding="0"
                            Margin="0,0,0,14">
                        <Border.Shadow>
                            <Shadow Brush="#64748B" Offset="0,8" Radius="18" Opacity="0.08" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="118,*" ColumnSpacing="14" Padding="12">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#E0F2F1"
                                    HeightRequest="118"
                                    WidthRequest="118"
                                    VerticalOptions="Start">
                                <Grid>
                                    <Image Source="{Binding ImageSource}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasImage}" />

                                    <VerticalStackLayout IsVisible="{Binding HasNoImage}"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Spacing="4">
                                        <Label Text="POI"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#0F766E"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="Ảnh"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="9"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <Label Text="{Binding DisplayDescription}"
                                       FontSize="14"
                                       TextColor="#64748B"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <HorizontalStackLayout Spacing="8">
                                    <Border BackgroundColor="#ECFDF5"
                                            Stroke="#A7F3D0"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="8,4">
                                        <Label Text="{Binding DisplayDistance}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#047857" />
                                    </Border>

                                    <Border BackgroundColor="#EEF2FF"
                                            Stroke="#C7D2FE"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="8,4">
                                        <Label Text="{Binding DisplayLanguage}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#3730A3" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Label Text="Chạm để xem chi tiết"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
